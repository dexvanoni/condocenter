{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run",
        "cypress:access": "node cypress/scripts/run-access-tests.mjs",
        "cypress:access:run": "cypress run --spec \"cypress/e2e/access-control/**/*.cy.js\"",
        "cypress:prepare": "node -e \"require('child_process').execSync((process.env.CYPRESS_PHP_PATH||'php')+' cypress/scripts/ensure-test-users.php',{stdio:'inherit',cwd:'.'})\""
    },
    "devDependencies": {
        "cypress": "^14.5.4",
        "@popperjs/core": "^2.11.8",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "axios": "^1.12.2",
        "bootstrap": "^5.3.8",
        "concurrently": "^9.0.1",
        "datatables.net-bs5": "^2.3.4",
        "datatables.net-dt": "^2.3.4",
        "laravel-vite-plugin": "^2.0.0",
        "sass": "^1.93.2",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "vue": "^3.5.22"
    },
    "dependencies": {
        "@zxing/library": "^0.21.3"
    }
}
