APP_NAME=SindCON
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Documentação interna da VPS (somente quem tiver este link). Deixe TOKEN vazio para desligar a rota.
DEV_DOCS_TOKEN=
DEV_DOCS_URL="${APP_URL}/dev/docs/"

# Use "ngrok" ao expor o app via túnel ngrok (força URLs em HTTPS)
# AMBIENTE=ngrok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Asaas — fallback quando não configurado no painel Plataforma > Asaas (SaaS)
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_EMAIL=admin@condomanager.com
ASAAS_WEBHOOK_TOKEN=

# WhatsApp — Evolution API (fallback quando não configurado no painel Plataforma > WhatsApp)
# WhatsApp / Evolution API (instância global da plataforma — cobranças SaaS)
# Cada condomínio configura sua própria instância em Configurações → WhatsApp
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Supabase — leads da landing de vendas SindCON (Configurações globais > Leads)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_LEADS_ADMIN_TOKEN=

# Controle de acesso por assinatura do condomínio
SAAS_ENFORCE_SUBSCRIPTION=true
SAAS_GRACE_DAYS=0
SAAS_WEBHOOK_BASE_URL="${APP_URL}"
# E-mail ou texto exibido ao síndico quando o limite de unidades do condomínio for atingido
SAAS_DEVELOPER_CONTACT=

# OCR de etiquetas (Encomenda Inteligente) — Tesseract no SO
OCR_ENABLED=true
OCR_LANG=por
OCR_TIMEOUT=30
OCR_PREPROCESS_ENABLED=true
OCR_MAX_DIMENSION=2400
# Windows/Laragon exemplo: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"

# PaddleOCR (opcional — motor alternativo por condomínio)
# Windows: caminho completo do Python onde rodou pip install paddleocr
# PADDLE_OCR_PYTHON=C:\Python313\python.exe
# Se pip instalou só no seu usuário (AppData\Roaming), copie o caminho exibido por: php artisan ocr:diagnose
# PADDLE_OCR_PYTHONPATH=C:/Users/SEU_USUARIO/AppData/Roaming/Python/Python313/site-packages
# PADDLE_OCR_SCRIPT=
# PADDLE_OCR_TIMEOUT=120
# PADDLE_OCR_PREVIEW_TIMEOUT=75
# OCR_PREVIEW_TESSERACT_FAST_PATH=true
